{
  "runtimes": {
    "nvidia": {
      "args": [],
      "path": "nvidia-container-runtime"
    }
  },
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3"
  },
  "builder": {
    "gc": {
      "enabled": true,
      "policy": [
        { "reservedSpace": "10GB", "filter": ["unused-for=168h"] },
        { "reservedSpace": "30GB", "all": true }
      ]
    }
  },
  "default-address-pools": [
    { "base": "10.201.0.0/16", "size": 24 }
  ]
}
