# ~/.zshenv — PATH for login, interactive, script, and remote-command zsh.
typeset -U path PATH

[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

# Signed system-local packages, notably Apple Container, install here.
path=(/usr/local/bin /usr/local/sbin $path)

_brew_bin=
case "$(uname -s):$(uname -m)" in
  Darwin:arm64|Darwin:aarch64) _brew_candidates=(/opt/homebrew/bin/brew /usr/local/bin/brew) ;;
  Darwin:*)                   _brew_candidates=(/usr/local/bin/brew /opt/homebrew/bin/brew) ;;
  *)                          _brew_candidates=(/home/linuxbrew/.linuxbrew/bin/brew /usr/local/bin/brew /opt/homebrew/bin/brew) ;;
esac
for _candidate in "${_brew_candidates[@]}"; do
  [[ -x "$_candidate" ]] && { _brew_bin="$_candidate"; break; }
done
[[ -n "$_brew_bin" ]] || _brew_bin="${commands[brew]:-}"
if [[ -n "$_brew_bin" ]]; then
  BREW_PREFIX=$("$_brew_bin" --prefix 2>/dev/null || true)
  [[ -n "$BREW_PREFIX" && -d "$BREW_PREFIX/bin" ]] && \
    path=("$BREW_PREFIX/bin" "$BREW_PREFIX/sbin" $path)
fi
# Standalone user tools (notably uv/uvx, Claude, and Codex) are the winner even
# when path_helper or Homebrew had already inserted the directory elsewhere.
path=("$HOME/.local/bin" $path)
export PATH BREW_PREFIX
unset _brew_bin _candidate _brew_candidates

# Locale safety net — same policy as ~/.bashrc.
case "${LANG:-}" in
  *.UTF-8|*.utf8) : ;;
  *) export LANG=en_US.UTF-8 ;;
esac
