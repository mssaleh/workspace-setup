# ~/.zshrc — interactive shell. PATH is set in ~/.zshenv.

# Avoid duplicate precmd and key-binding hooks when this file is sourced twice
# in one process. This variable is not exported, so every new zsh initializes.
if [[ "${__WORKSPACE_ZSHRC_PID:-}" == "$$" ]]; then
  return
fi
__WORKSPACE_ZSHRC_PID=$$

# SSH agent socket — see ~/.bashrc for the full rationale. zsh needs the same
# guard because the systemd user ssh-agent.socket sets SSH_AUTH_SOCK in the
# user manager environment, not in every shell. macOS doesn't need this.
if [[ -z "${SSH_AUTH_SOCK:-}" && -n "${XDG_RUNTIME_DIR:-}" ]] && [[ "$(uname -s)" != Darwin ]]; then
  if [[ -S "$XDG_RUNTIME_DIR/openssh_agent" ]]; then
    export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/openssh_agent"
  elif [[ -S "$XDG_RUNTIME_DIR/ssh-agent.socket" ]]; then
    export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
  fi
fi

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS INC_APPEND_HISTORY
# The twin of HISTIGNORE in ~/.bashrc: commands that are quicker to retype than
# to find. zsh takes one extended-glob pattern matched against the whole line,
# where bash takes a colon-separated list, so the two spellings differ but the
# set does not.
HISTORY_IGNORE='(exit|ls|ll|la|cd|cd -|cd ..|pwd|clear|history|bg|fg|jobs|reset|y)'
setopt INTERACTIVE_COMMENTS

# Completion. Homebrew tools ship completions in $BREW_PREFIX/share/zsh/site-functions,
# which must be on fpath BEFORE compinit runs (this is what fixes `_eza: function not found`).
# On Linux, the system zsh completions live in /usr/share/zsh/site-functions (already on
# the default fpath), and bash-completion-equivalent tools ship their own _foo files there
# via apt. $BREW_PREFIX is exported by ~/.zshenv (with a `brew --prefix` fallback).
if [[ -n "${BREW_PREFIX:-}" && -d "$BREW_PREFIX/share/zsh/site-functions" ]]; then
  fpath=("$BREW_PREFIX/share/zsh/site-functions" $fpath)
fi
autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' menu select

# Completions for tools that don't drop a static _foo file into site-functions.
# Everything is guarded with `command -v` so this same block is safe on any host
# (a host lacking a given tool just self-skips that line). All must run AFTER compinit (above).
#   kitty/kitten completions are set up automatically by kitty's shell
#   integration (shell_integration enabled in kitty.conf ships a static _kitty
#   on fpath) — the documented method. We deliberately do NOT
#   `source <(kitten __complete__ setup zsh)`: that internal command is redundant
#   here and can leak a colored warning onto stdout that breaks `source` with a
#   "bad pattern: <esc>[33mkitten…" error. https://sw.kovidgoyal.net/kitty/shell-integration/
#   `y` is the yazi cd-on-quit wrapper (below) — complete it exactly like yazi:
command -v yazi   >/dev/null 2>&1 && compdef y=yazi
#   _gnu_generic = flag completion parsed from `--help`, for tools that ship no
#   zsh completion. For `delta` it also overrides zsh's wrong default binding to
#   the ancient SCCS `_sccs`:
for _c in delta lazygit node; do command -v $_c >/dev/null 2>&1 && compdef _gnu_generic $_c; done
unset _c

# ── Prompt & window title: WHICH MACHINE am I on? ───────────────────────────
# The #1 job of this prompt is to make local-vs-remote unmistakable. A remote
# shell renders its OWN prompt over SSH, so putting the host here means: SSH to
# the mini shows "mini", and `exit` visibly drops you back to "macbook". Each
# host gets a stable accent colour so the machines are distinct at a glance.
# This file is byte-identical on every machine; the block below derives the
# label + colour from $HOST at startup, so there are no per-machine edits.
case "$HOST" in
  *MacBook*|*macbook*)          _host_label='macbook'; _host_color=150 ;;  # green
  *Mac-mini*|*mac-mini*|*Mini*) _host_label='mini';    _host_color=215 ;;  # peach
  *)                            _host_label='%m';      _host_color=245 ;;  # other host: grey + real name
esac

# Working directory + git branch, prefixed with the host badge.
autoload -Uz vcs_info
zstyle ':vcs_info:git:*' formats ' (%b)'
setopt PROMPT_SUBST
PROMPT="%B%F{$_host_color}${_host_label}%f%b %F{blue}%~%f%F{242}\${vcs_info_msg_0_}%f %# "

# Terminal/tab title = "<machine>: <dir>" — shows in kitty's title bar, tab bar
# and the Cmd+` window switcher. kitty.conf sets `shell_integration ... no-title`
# so kitty won't overwrite this. OSC 2 sets the title; print -P expands %~.
function _set_term_title() { print -Pn "\e]2;${_host_label}: %~\a"; }
precmd_functions+=(vcs_info _set_term_title)

export EDITOR=nano

# yazi: `y` opens the file manager and cd's to the directory you quit in.
# Official wrapper: https://yazi-rs.github.io/docs/quick-start
# (mktemp: use $TMPDIR + XXXXXX template — portable across macOS and Linux.
# `mktemp -t <template>` has different semantics on macOS vs Linux; this form
# works identically on both.)
function y() {
	local tmp cwd
	tmp="$(mktemp "${TMPDIR:-/tmp}/yazi-cwd.XXXXXX")"
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp" 2>/dev/null || cwd=""
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	command rm -f -- "$tmp"
}

# ds: durable remote session — mosh (survives wifi drop / network roam) + tmux
# on the remote (survives SSH disconnect; not remote reboot). Usage: ds mini | ds user@host
# LC_ALL forces a valid UTF-8 locale so mosh doesn't choke on macOS sending
# LC_CTYPE=UTF-8; the explicit TERM baseline keeps Mosh portable to old hosts.
function ds() {
  local host="$1"
  if [ -z "$host" ]; then
    print -u2 "usage: ds <host>"
    return 2
  fi
  if ! command -v mosh >/dev/null 2>&1; then
    print -u2 "ds: mosh is not installed locally"
    return 127
  fi
  # Probe for mosh-server + tmux before handing over to mosh, whose own failure
  # output is opaque. Deliberately no BatchMode: on a first connection ssh has
  # to be able to ask you to accept the host key, and BatchMode turns that into
  # "Host key verification failed" — which the old single-branch check then
  # misreported as a missing mosh-server. ssh reserves exit 255 for its own
  # errors, so the two failure modes stay distinguishable.
  local probe_status
  command ssh -o ConnectTimeout=8 -o ConnectionAttempts=1 "$host" \
    'command -v mosh-server >/dev/null && command -v tmux >/dev/null' >/dev/null
  probe_status=$?
  if [ "$probe_status" -eq 255 ]; then
    print -u2 "ds: ssh to $host failed — unreachable, host key rejected, or auth refused (see ssh's message above)"
    print -u2 "ds: check with: ssh -o ConnectTimeout=8 $host"
    return 255
  elif [ "$probe_status" -ne 0 ]; then
    print -u2 "ds: $host is reachable but has no mosh-server and/or tmux"
    print -u2 "ds: install them with: ssh $host 'sudo apt install -y mosh tmux'"
    return "$probe_status"
  fi
  # A client that dies without exiting cleanly — terminal closed, laptop lid,
  # mosh's own `Ctrl-^ .` — strands a mosh-server that is still holding a pty
  # with a tmux client attached to it. mosh has no reattach, so that server is
  # unreachable forever. Two settings make it self-healing:
  #
  #   -D  on reattach evicts the stale tmux client. That client is the stranded
  #       mosh-server's only child, so the server exits with it — every `ds`
  #       collects the previous corpse. The trade-off is one client at a time:
  #       two machines can no longer share a live view of the session.
  #   MOSH_SERVER_NETWORK_TMOUT  retires an abandoned server after a week with
  #       no client contact, covering the case where you never return to this
  #       host. It ends only the mosh-server; the tmux session and every shell
  #       in it keep running, detached, exactly as after Ctrl-b d.
  #
  # mosh interpolates --server into the remote command line without quoting it,
  # which is what lets the `env` prefix survive to the remote shell.
  LC_ALL=en_US.UTF-8 TERM=xterm-256color \
    mosh --ssh="ssh -o ConnectTimeout=8 -o ConnectionAttempts=1" \
         --server='env MOSH_SERVER_NETWORK_TMOUT=604800 mosh-server' \
         "$host" -- tmux new -A -D -s main
}

# Plain `ssh` preserves xterm-kitty for managed hosts. `s` is the explicit
# compatibility path for old hosts that do not have kitty's terminfo.
function s() { TERM=xterm-256color command ssh "$@"; }

# ks: opt in to Kitty's ssh kitten for hosts where you want Kitty integration.
# The kitten refuses to run outside a kitty window ("Error: The SSH kitten is
# meant to run inside a kitty window") — it needs kitty's escape-code channel to
# ship terminfo and shell integration to the remote. Testing for the binary
# alone was the wrong gate: kitten is on PATH in every terminal, so from GNOME
# Terminal or a plain tty ks errored out instead of taking the ssh fallback that
# the else-branch exists for.
function ks() {
  if [ -n "$KITTY_WINDOW_ID" ] && command -v kitten >/dev/null 2>&1; then
    kitten ssh "$@"
  else
    command ssh "$@"
  fi
}

# fzf: fuzzy finder. Ctrl-R fuzzy history · Ctrl-T insert file paths · Alt-C cd
# into a subdir · `**<Tab>` fuzzy completion. Official zsh integration (defines
# the key-binding widgets + completion):  https://github.com/junegunn/fzf
if command -v fzf >/dev/null 2>&1; then
  # Source `fd` (respects .gitignore, includes dotfiles, skips .git) for speed:
  command -v fd >/dev/null 2>&1 && {
    export FZF_DEFAULT_COMMAND='fd --hidden --strip-cwd-prefix --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type=d --hidden --strip-cwd-prefix --exclude .git'
  }
  # Layout + Catppuccin Mocha palette (https://github.com/catppuccin/fzf):
  export FZF_DEFAULT_OPTS="
    --height=60% --layout=reverse --border=rounded --info=inline
    --bind=ctrl-/:toggle-preview
    --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8
    --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc
    --color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8
    --color=selected-bg:#45475a,border:#585b70,label:#cdd6f4"
  # Previews: Ctrl-T shows files via bat / dirs via eza; Alt-C shows the tree;
  # Ctrl-R shows the full command (toggle with Ctrl-/).
  export FZF_CTRL_T_OPTS="--preview '(bat --color=always --style=numbers {} || eza --tree --color=always {}) 2>/dev/null | head -200'"
  export FZF_ALT_C_OPTS="--preview 'eza --tree --color=always {} 2>/dev/null | head -200'"
  export FZF_CTRL_R_OPTS="--preview 'echo {}' --preview-window=down:3:hidden:wrap --bind=ctrl-/:toggle-preview"
  # fzf's zsh keybindings assume a real terminal; skip them in non-TTY shells
  # such as automated `zsh -ic` SSH checks.
  if [[ -t 0 && -t 1 ]]; then
    source <(fzf --zsh)
  fi
fi

# Keep directory jumping available even when fzf is absent.
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# Plugins (Homebrew, sourced — not aliases). Syntax highlighting is sourced at
# the absolute end of the file, as required by the plugin.
# OS-aware: on Homebrew they live under $BREW_PREFIX/share/<plugin>/; on Linux
# distros that ship them as packages (Debian/Ubuntu: zsh-autosuggestions,
# zsh-syntax-highlighting) they live in /usr/share/zsh-<plugin>/.
_zsh_plugin() {
  local name="$1" file="$2"
  local brew_path="${BREW_PREFIX:-/opt/homebrew}/share/$name/$file"
  local linux_path="/usr/share/$name/$file"
  [[ -r "$brew_path" ]]  && { source "$brew_path";  return 0; }
  [[ -r "$linux_path" ]] && { source "$linux_path"; return 0; }
  return 1
}
_zsh_plugin zsh-autosuggestions zsh-autosuggestions.zsh

# ── Linux-style navigation keys ────────────────────────────────────────────
# Make Home / End / forward-Delete work at the shell prompt like they do on
# Linux, regardless of $TERM. We bind the escape sequences every common
# terminal emits (xterm normal + application cursor mode + vt/linux + rxvt) so
# this is correct in kitty, Terminal.app, iTerm, tmux and over ssh. Page Up/Down
# have no per-line meaning in a shell, so they fall through to the terminal's
# scrollback (kitty: Shift+PageUp/Down) — same as Linux.
bindkey '^[[H'    beginning-of-line     # Home  (xterm)
bindkey '^[OH'    beginning-of-line     # Home  (application cursor mode)
bindkey '^[[1~'   beginning-of-line     # Home  (vt / linux console)
bindkey '^[[7~'   beginning-of-line     # Home  (rxvt)
bindkey '^[[F'    end-of-line           # End   (xterm)
bindkey '^[OF'    end-of-line           # End   (application cursor mode)
bindkey '^[[4~'   end-of-line           # End   (vt / linux console)
bindkey '^[[8~'   end-of-line           # End   (rxvt)
bindkey '^[[3~'   delete-char           # forward-Delete
bindkey '^[[3;5~' kill-word             # Ctrl+Delete → delete word to the right
# Word jumps to match Linux Ctrl+Left / Ctrl+Right:
bindkey '^[[1;5D' backward-word         # Ctrl+Left
bindkey '^[[1;5C' forward-word          # Ctrl+Right

_zsh_plugin zsh-syntax-highlighting zsh-syntax-highlighting.zsh
unset -f _zsh_plugin
