# ~/.inputrc — readline (bash and any readline-based CLI). The bash twin of
# the zsh `bindkey` block in ~/.zshrc: Home / End / forward-Delete / word jumps
# work Linux-style in every terminal (kitty, Terminal.app, tmux, over ssh).
# Byte-identical on every machine (Mac + Linux).
"\e[H":    beginning-of-line
"\eOH":    beginning-of-line
"\e[1~":   beginning-of-line
"\e[7~":   beginning-of-line
"\e[F":    end-of-line
"\eOF":    end-of-line
"\e[4~":   end-of-line
"\e[8~":   end-of-line
"\e[3~":   delete-char
"\e[3;5~": kill-word
"\e[1;5D": backward-word
"\e[1;5C": forward-word

# Case-insensitive completion (mirrors the zsh matcher-list in ~/.zshrc)
set completion-ignore-case on
set completion-map-case on
set colored-completion-prefix on
set colored-stats on
set visible-stats on
set mark-symlinked-directories on
set menu-complete-display-prefix on
set show-all-if-ambiguous on
set skip-completed-text on
set enable-bracketed-paste on

# With text already entered, Up/Down search commands beginning with that text.
# fzf owns Ctrl-R when available; these remain fast, predictable Readline
# fallbacks for prefix history navigation.
"\e[A": history-search-backward
"\eOA": history-search-backward
"\e[B": history-search-forward
"\eOB": history-search-forward
