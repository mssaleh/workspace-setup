# ~/.ssh/config — read automatically by ssh and kitty's ssh kitten.
# The per-host block below is an example; edit to match your own hosts.

# Example: a host on a ZeroTier overlay at 10.10.10.12. Uncomment and edit
# the User line (replace "your-user" with your remote username).
# Host mini macmini 10.10.10.12
#     HostName 10.10.10.12
#     User your-user
#     IdentityFile ~/.ssh/id_ed25519
#     IdentitiesOnly yes

# `ks <host>` is the managed-host profile: kitty ships its terminfo and shell
# integration. `s <host>` is the legacy profile and advertises xterm-256color.
# `ds <host>` remains the durable Mosh + tmux profile.

# Defaults for every host. Plain SSH fails a dead connection in about three
# minutes; Mosh + tmux, rather than a three-hour keepalive grace period, owns
# session durability. Multiplexing removes repeat-authentication latency while
# keeping each master short-lived and its socket inside a private directory.
Host *
    AddKeysToAgent yes
    ConnectTimeout 10
    ConnectionAttempts 1
    ServerAliveInterval 30
    ServerAliveCountMax 6
    TCPKeepAlive no
    ControlMaster auto
    ControlPersist 10m
    ControlPath ~/.ssh/controlmasters/%C
    HashKnownHosts yes
    UpdateHostKeys yes
