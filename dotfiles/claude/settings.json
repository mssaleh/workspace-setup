{
  "statusLine": {
    "type": "command",
    "command": "${BASH_BIN} ${HOME}/.claude/statusline-command.sh"
  },
  "permissions": {
    "deny": [
      "Bash(brew install *)",
      "Bash(brew uninstall *)",
      "Bash(brew reinstall *)",
      "Bash(brew upgrade *)",
      "Bash(brew tap *)",
      "Bash(brew untap *)",
      "Bash(brew services *)",
      "Bash(brew pin *)",
      "Bash(brew unpin *)",
      "Bash(brew link *)",
      "Bash(brew unlink *)",
      "Bash(brew install --cask *)",
      "Bash(brew fetch *)",
      "Bash(brew extract *)",
      "Bash(apt install *)",
      "Bash(apt remove *)",
      "Bash(apt purge *)",
      "Bash(apt upgrade *)",
      "Bash(apt-get install *)",
      "Bash(apt-get remove *)",
      "Bash(apt-get purge *)",
      "Bash(apt-get upgrade *)",
      "Bash(snap install *)",
      "Bash(snap remove *)"
    ]
  }
}