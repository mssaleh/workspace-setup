# shellcheck shell=bash
# ~/.bashrc — shared PATH setup plus interactive shell behavior.
# The bash twin of ~/.zshrc: same minimal setup, same prompt, same functions,
# NO command aliases. Byte-identical on every machine (Mac + Linux).

# This file installs hooks into PROMPT_COMMAND and Readline. Re-sourcing it in
# the same process would duplicate those hooks; start a fresh login shell when
# deploying changes instead. The marker is intentionally not exported, so a
# child Bash process still performs its own initialization.
if [[ "${__WORKSPACE_BASHRC_PID:-}" == "$BASHPID" ]]; then
  return
fi
__WORKSPACE_BASHRC_PID=$BASHPID

# Helper: source the first readable file from the list. Used for OS-aware
# sourcing (try Homebrew path first, fall back to Linux path).
_source_first() {
  local f
  for f in "$@"; do
    if [[ -r "$f" ]]; then
      . "$f"
      return 0
    fi
  done
  return 1
}

# PATH for every bash that reads this file — the twin of ~/.zshenv's job.
# Non-interactive `ssh host cmd` bypasses ~/.bash_profile but DOES read
# ~/.bashrc, so Homebrew and ~/.local/bin must be asserted before the
# interactivity gate below or remote commands get the bare sshd PATH.
# A bare sshd PATH cannot find Apple Silicon Homebrew, so probe its standard
# absolute locations as well as command -v. Intel macOS and Linuxbrew are also
# covered. Never synthesize /bin from an empty prefix.
_find_brew_bin() {
  local candidate path_brew
  local -a candidates
  case "$(uname -s):$(uname -m)" in
    Darwin:arm64|Darwin:aarch64) candidates=(/opt/homebrew/bin/brew /usr/local/bin/brew) ;;
    Darwin:*)                   candidates=(/usr/local/bin/brew /opt/homebrew/bin/brew) ;;
    *)                          candidates=(/home/linuxbrew/.linuxbrew/bin/brew /usr/local/bin/brew /opt/homebrew/bin/brew) ;;
  esac
  for candidate in "${candidates[@]}"; do
    [[ -x "$candidate" ]] && { printf '%s\n' "$candidate"; return 0; }
  done
  path_brew=$(type -P brew 2>/dev/null || true)
  [[ -n "$path_brew" && -x "$path_brew" ]] && { printf '%s\n' "$path_brew"; return 0; }
  return 1
}

# Remove an existing occurrence before prepending, so a rerun/source repairs
# ordering instead of merely noticing that a lower-priority entry exists.
_path_prepend() {
  local wanted="$1" entry new_path="" old_ifs="$IFS"
  local -a path_parts
  [[ -d "$wanted" ]] || return 0
  IFS=:
  read -r -a path_parts <<< "${PATH:-}"
  IFS="$old_ifs"
  for entry in "${path_parts[@]}"; do
    [[ "$entry" == "$wanted" ]] && continue
    new_path="${new_path}${new_path:+:}${entry}"
  done
  PATH="$wanted${new_path:+:$new_path}"
}

# The tail-end twin of _path_prepend, for entries that must lose to everything
# already on PATH. Same remove-then-add shape, so re-sourcing cannot duplicate.
_path_append() {
  local wanted="$1" entry new_path="" old_ifs="$IFS"
  local -a path_parts
  [[ -d "$wanted" ]] || return 0
  IFS=:
  read -r -a path_parts <<< "${PATH:-}"
  IFS="$old_ifs"
  for entry in "${path_parts[@]}"; do
    [[ "$entry" == "$wanted" ]] && continue
    new_path="${new_path}${new_path:+:}${entry}"
  done
  PATH="${new_path:+$new_path:}$wanted"
}

# Vendor profile scripts can prepend the same toolchain block every time a
# login shell is nested. Keep the first occurrence of every inherited entry so
# PATH remains stable without changing command precedence.
_path_dedupe() {
  local entry existing duplicate deduped_path="" old_ifs="$IFS"
  local -a path_parts unique_parts
  IFS=:
  read -r -a path_parts <<< "${PATH:-}"
  IFS="$old_ifs"
  for entry in "${path_parts[@]}"; do
    [[ -n "$entry" ]] || continue
    duplicate=
    for existing in "${unique_parts[@]}"; do
      if [[ "$existing" == "$entry" ]]; then
        duplicate=1
        break
      fi
    done
    [[ -n "$duplicate" ]] || unique_parts+=("$entry")
  done
  for entry in "${unique_parts[@]}"; do
    deduped_path="${deduped_path}${deduped_path:+:}${entry}"
  done
  PATH="$deduped_path"
}

[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

# Apple and other conventional signed packages install CLIs here. sshd's bare
# macOS PATH omits both directories, so assert them before Homebrew.
_path_prepend /usr/local/sbin
_path_prepend /usr/local/bin

_brew_bin=$(_find_brew_bin 2>/dev/null || true)
if [[ -n "$_brew_bin" ]]; then
  BREW_PREFIX=$("$_brew_bin" --prefix 2>/dev/null || true)
  if [[ -n "$BREW_PREFIX" ]]; then
    _path_prepend "$BREW_PREFIX/sbin"
    _path_prepend "$BREW_PREFIX/bin"
  fi
fi
_path_prepend "$HOME/.local/bin"

# npm's global prefix lives in $HOME so `npm i -g` never needs sudo and never
# writes into a package manager's tree. Appended, not prepended: an npm-global
# CLI must not shadow the same command installed by its own upstream provider
# into ~/.local/bin, which is the artifact the setup verifies.
NPM_PACKAGES="${NPM_PACKAGES:-$HOME/.npm/packages}"
case ":${NODE_PATH:-}:" in
  *":$NPM_PACKAGES/lib/node_modules:"*) ;;
  *) NODE_PATH="$NPM_PACKAGES/lib/node_modules${NODE_PATH:+:$NODE_PATH}" ;;
esac
_path_append "$NPM_PACKAGES/bin"
export NPM_PACKAGES NODE_PATH

_path_dedupe
export PATH BREW_PREFIX
unset _brew_bin
unset -f _find_brew_bin _path_prepend _path_append _path_dedupe

# Locale safety net: ensure a UTF-8-capable LANG is set.
# macOS: region "en_AE" has no POSIX locale, so several contexts (Terminal.app,
#   ssh clients that don't send LANG, bare launchd) start bash with no usable
#   locale — brew bash 5.3 then prints "setlocale: … cannot change locale ()"
#   warnings the moment bash-completion (below) probes the locale.
# Linux: a fresh `sudo -i` shell, an SSH session with a stripped env, or a
#   minimal container can land with LANG=C / LANG=POSIX (ASCII-only — breaks
#   git, less, python, mosh-server refuses to start) or LANG= (empty).
# Default to en_US.UTF-8 (universally available, locale-neutral for CLI work)
# unless the current LANG is already UTF-8-capable. en_US.UTF-8 specifically
# (not C.UTF-8) because the `ds` mosh wrapper forces LC_ALL=en_US.UTF-8 and
# mosh-server exits 1 if that locale isn't generated.
case "${LANG:-}" in
  *.UTF-8|*.utf8) : ;;                                   # already UTF-8 → leave it
  *) export LANG=en_US.UTF-8 ;;                          # unset/empty/C/POSIX → upgrade
esac

# Non-interactive shells stop here (scp, `ssh host cmd`, scripts, …).
case $- in *i*) ;; *) return ;; esac

# SSH agent socket — on Linux the systemd user ssh-agent.socket exposes its
# socket at $XDG_RUNTIME_DIR/openssh_agent. An incoming SSH session owns every
# nonempty SSH_AUTH_SOCK supplied by sshd, so preserve it without probing or
# replacing it. A desktop shell can select the local OpenSSH socket instead of
# a competing desktop agent, and an SSH session without forwarding can use the
# local socket as a fallback. macOS uses its launchd-managed system agent.
if [[ -n "${XDG_RUNTIME_DIR:-}" && "$(uname -s)" != Darwin ]]; then
  _local_agent=
  [[ -S "$XDG_RUNTIME_DIR/openssh_agent" ]] && _local_agent="$XDG_RUNTIME_DIR/openssh_agent"
  [[ -z "$_local_agent" && -S "$XDG_RUNTIME_DIR/ssh-agent.socket" ]] \
    && _local_agent="$XDG_RUNTIME_DIR/ssh-agent.socket"
  # GUI sessions may inherit GCR's separate agent. Prefer the local OpenSSH
  # socket there, while treating a nonempty SSH-session value as authoritative.
  if [[ -n "$_local_agent" ]] \
      && { [[ -z "${SSH_CONNECTION:-}" ]] || [[ -z "${SSH_AUTH_SOCK:-}" ]]; }; then
    export SSH_AUTH_SOCK="$_local_agent"
  fi
  unset _local_agent
fi

# History — approximates zsh SHARE_HISTORY/IGNORE_ALL_DUPS: big, deduped,
# written after every command instead of on shell exit.
HISTSIZE=100000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth:erasedups
HISTTIMEFORMAT='%F %T  '
# Commands whose next invocation is always easier to retype than to find. `exit`
# alone was a fifth of a real history file. The patterns are anchored whole-line,
# so `cd ..` and `ls -la` are still recorded — only the bare forms are dropped.
HISTIGNORE='exit:ls:ll:la:cd:cd -:cd ..:pwd:clear:history:bg:fg:jobs:reset:y'
shopt -s histappend
shopt -s checkwinsize

# Completion. bash-completion@2's entry point sources every file in its compat
# directory ($BREW_PREFIX/etc/bash_completion.d on macOS, /etc/bash_completion.d
# on Linux) eagerly, right here at startup; per-command completions elsewhere —
# including ~/.local/share/bash-completion/completions — load lazily on first
# Tab. On Linux the entry point is /usr/share/bash-completion/bash_completion
# (apt's bash-completion package). Source whichever exists via _source_first.
#
# himalaya is excluded from the compat directory: himalaya ≥ 2.0 writes its
# completion script to a file and prints a status line to stdout, while the
# Homebrew formula still captures stdout — so every brew install/upgrade ships
# a one-line status message that is a bash syntax error into a location every
# interactive shell sources. The patterns are |-separated extglob alternatives.
# Working himalaya completion comes from the loader the dotfiles stage places
# in ~/.local/share/bash-completion/completions/himalaya, which regenerates
# the real script from the installed binary on first use.
BASH_COMPLETION_COMPAT_IGNORE="${BASH_COMPLETION_COMPAT_IGNORE:+${BASH_COMPLETION_COMPAT_IGNORE}|}himalaya"
if [[ -n "${BREW_PREFIX:-}" ]]; then
  _source_first "$BREW_PREFIX/etc/profile.d/bash_completion.sh" \
                /usr/share/bash-completion/bash_completion \
                /etc/bash_completion
else
  _source_first /usr/share/bash-completion/bash_completion /etc/bash_completion
fi

# ── Prompt & window title: WHICH MACHINE am I on? ───────────────────────────
# Same rule as ~/.zshrc: the #1 job of the prompt is making local-vs-remote
# unmistakable. Host badge + cwd + git branch; per-host accent colour.
case "$HOSTNAME" in
  *MacBook*|*macbook*)          _host_label='macbook'; _host_color=150 ;;  # green
  *Mac-mini*|*mac-mini*|*Mini*) _host_label='mini';    _host_color=215 ;;  # peach
  *)                            _host_label=${HOSTNAME%%.*}; _host_color=245 ;;  # other: grey + real name
esac

__prompt_git() {
  local b
  b=$(git symbolic-ref --short -q HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)
  [ -n "$b" ] && printf ' (%s)' "$b"
}
PS1="\[\e[1;38;5;${_host_color}m\]${_host_label}\[\e[0m\] \[\e[34m\]\w\[\e[0m\]\[\e[38;5;242m\]\$(__prompt_git)\[\e[0m\] \\$ "

# Terminal/tab title = "<machine>: <dir>" (kitty.conf uses `no-title` so the
# shell owns it).
__set_term_title() { printf '\e]2;%s: %s\a' "$_host_label" "${PWD/#$HOME/\~}"; }

# Shared, genuinely deduplicated history across every live terminal.
#
# HISTCONTROL=erasedups prunes the in-memory list, never the file, and `history
# -a` only appends lines this shell has not written yet — so the pair that looks
# like it dedupes (`-a` then `-n`) lets the file grow a duplicate for every
# repeat. Measured on a real history file: 354 entries, 144 unique.
#
# `-w` is what rewrites the file from the deduped in-memory list, and `-n` has
# to come first so lines another terminal added since the last read are imported
# before that rewrite replaces the file. `-c; -r` then resyncs this shell, so
# Up and Ctrl-R immediately see what every other terminal has run.
__history_sync() { history -n; history -w; history -c; history -r; }
if ((BASH_VERSINFO[0] >= 5)); then
  if [[ "$(declare -p PROMPT_COMMAND 2>/dev/null)" != 'declare -a'* ]]; then
    _prompt_command_previous=${PROMPT_COMMAND:-}
    PROMPT_COMMAND=()
    [[ -z "$_prompt_command_previous" ]] || PROMPT_COMMAND+=("$_prompt_command_previous")
    unset _prompt_command_previous
  fi
  PROMPT_COMMAND+=(__history_sync __set_term_title)
else
  # shellcheck disable=SC2128,SC2178 # Bash <5 scalar compatibility branch
  PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND; }__history_sync; __set_term_title"
fi

export EDITOR=nano VISUAL=nano SUDO_EDITOR=nano
# Respect an explicitly supplied pager (coding agents commonly use `cat`), but
# give human terminals a color-safe pager that exits for one-screen output and
# leaves completed output visible in scrollback.
PAGER=${PAGER:-less}
LESS=${LESS:--FRXMi}
MANPAGER=${MANPAGER:-'less -R'}
SYSTEMD_PAGER=${SYSTEMD_PAGER:-less}
SYSTEMD_LESS=${SYSTEMD_LESS:-FRXMK}
export PAGER LESS MANPAGER SYSTEMD_PAGER SYSTEMD_LESS

# yazi: `y` opens the file manager and cd's to the directory you quit in.
# Official wrapper: https://yazi-rs.github.io/docs/quick-start
# (mktemp: use $TMPDIR + XXXXXX template — portable across macOS and Linux.)
function y() {
	local tmp cwd
	tmp="$(mktemp "${TMPDIR:-/tmp}/yazi-cwd.XXXXXX")"
	command yazi "$@" --cwd-file="$tmp"
	cwd="$(command cat -- "$tmp" 2>/dev/null)"
	if [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && [ -d "$cwd" ]; then
		builtin cd -- "$cwd" || return
	fi
	command rm -f -- "$tmp"
}

# ds: durable remote session — mosh (survives wifi drop / network roam) + tmux
# on the remote (survives SSH disconnect; not remote reboot). Usage: ds mini | ds user@host
# LC_ALL forces a valid UTF-8 locale so mosh doesn't choke on macOS sending
# LC_CTYPE=UTF-8; the explicit TERM baseline keeps Mosh portable to legacy hosts.
function ds() {
  local host="$1"
  if [ -z "$host" ]; then
    echo "usage: ds <host>" >&2
    return 2
  fi
  if ! command -v mosh >/dev/null 2>&1; then
    echo "ds: mosh is not installed locally" >&2
    return 127
  fi
  # Probe for mosh-server + tmux before handing over to mosh, whose own failure
  # output is opaque. Deliberately no BatchMode: on a first connection ssh has
  # to be able to ask you to accept the host key, and BatchMode turns that into
  # "Host key verification failed" — which the old single-branch check then
  # misreported as a missing mosh-server. ssh reserves exit 255 for its own
  # errors, so the two failure modes stay distinguishable.
  local probe_status
  command ssh -o ConnectTimeout=8 -o ConnectionAttempts=1 "$host" \
    'command -v mosh-server >/dev/null && command -v tmux >/dev/null' >/dev/null
  probe_status=$?
  if [ "$probe_status" -eq 255 ]; then
    echo "ds: ssh to $host failed — unreachable, host key rejected, or auth refused (see ssh's message above)" >&2
    echo "ds: check with: ssh -o ConnectTimeout=8 $host" >&2
    return 255
  elif [ "$probe_status" -ne 0 ]; then
    echo "ds: $host is reachable but has no mosh-server and/or tmux" >&2
    echo "ds: install them with: ssh $host 'sudo apt install -y mosh tmux'" >&2
    return "$probe_status"
  fi
  # A client that dies without exiting cleanly — terminal closed, laptop lid,
  # mosh's own `Ctrl-^ .` — strands a mosh-server that is still holding a pty
  # with a tmux client attached to it. mosh has no reattach, so that server is
  # unreachable forever. Two settings make it self-healing:
  #
  #   -D  on reattach evicts the stale tmux client. That client is the stranded
  #       mosh-server's only child, so the server exits with it — every `ds`
  #       collects the previous corpse. The trade-off is one client at a time:
  #       two machines can no longer share a live view of the session.
  #   MOSH_SERVER_NETWORK_TMOUT  retires an abandoned server after a week with
  #       no client contact, covering the case where you never return to this
  #       host. It ends only the mosh-server; the tmux session and every shell
  #       in it keep running, detached, exactly as after Ctrl-b d.
  #
  # mosh interpolates --server into the remote command line without quoting it,
  # which is what lets the `env` prefix survive to the remote shell.
  LC_ALL=en_US.UTF-8 TERM=xterm-256color \
    mosh --ssh="ssh -o ConnectTimeout=8 -o ConnectionAttempts=1" \
         --server='env MOSH_SERVER_NETWORK_TMOUT=604800 mosh-server' \
         "$host" -- tmux new -A -D -s main
}

# Managed hosts install xterm-kitty terminfo without a GUI dependency, so plain
# `ssh` preserves TERM. `s` advertises xterm-256color to unmanaged hosts.
function s() { TERM=xterm-256color command ssh "$@"; }

# ks: opt in to Kitty's ssh kitten for hosts where you want Kitty integration.
# The kitten refuses to run outside a kitty window ("Error: The SSH kitten is
# meant to run inside a kitty window") — it needs kitty's escape-code channel to
# ship terminfo and shell integration to the remote. Testing for the binary
# alone was the wrong gate: kitten is on PATH in every terminal, so from GNOME
# Terminal or a plain tty ks errored out instead of taking the ssh fallback that
# the else-branch exists for.
function ks() {
  if [ -n "$KITTY_WINDOW_ID" ] && command -v kitten >/dev/null 2>&1; then
    kitten ssh "$@"
  else
    command ssh "$@"
  fi
}

# fzf: fuzzy finder. Ctrl-R fuzzy history · Ctrl-T insert file paths · Alt-C cd
# into a subdir · `**<Tab>` fuzzy completion. Official bash integration:
# https://github.com/junegunn/fzf
if command -v fzf >/dev/null 2>&1; then
  # Source `fd` (respects .gitignore, includes dotfiles, skips .git) for speed:
  command -v fd >/dev/null 2>&1 && {
    export FZF_DEFAULT_COMMAND='fd --hidden --strip-cwd-prefix --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type=d --hidden --strip-cwd-prefix --exclude .git'
  }
  # Layout + Catppuccin Mocha palette (https://github.com/catppuccin/fzf):
  export FZF_DEFAULT_OPTS="
    --height=60% --layout=reverse --border=rounded --info=inline
    --bind=ctrl-/:toggle-preview
    --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8
    --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc
    --color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8
    --color=selected-bg:#45475a,border:#585b70,label:#cdd6f4"
  # Previews: Ctrl-T shows files via bat / dirs via eza; Alt-C shows the tree;
  # Ctrl-R shows the full command (toggle with Ctrl-/).
  export FZF_CTRL_T_OPTS="--preview '(bat --color=always --style=numbers {} || eza --tree --color=always {}) 2>/dev/null | head -200'"
  export FZF_ALT_C_OPTS="--preview 'eza --tree --color=always {} 2>/dev/null | head -200'"
  export FZF_CTRL_R_OPTS="--preview 'echo {}' --preview-window=down:3:hidden:wrap --bind=ctrl-/:toggle-preview"
  # fzf's key bindings assume a real terminal; skip them in automated and
  # redirected shells.
  if [ -t 0 ] && [ -t 1 ]; then
    eval "$(fzf --bash)"
  fi
fi

# Keep directory jumping available even when fzf is absent.
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init bash)"
fi

# direnv: per-project environment, loaded on cd and unloaded on the way out.
# This is what keeps toolchains out of the global PATH — most concretely the
# STM32CubeCLT build tools, which /etc/profile.d/zz-stm32cubeclt-path.sh removes
# from every login shell and ~/.config/direnv/direnvrc hands back to the one
# project that wants them (`use stm32` in its .envrc).
#
# Hooked last, after zoxide and fzf: direnv's hook appends to PROMPT_COMMAND and
# must see the finished value. The re-source guard at the top of this file keeps
# a second source from stacking a second hook.
if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook bash)"
fi
