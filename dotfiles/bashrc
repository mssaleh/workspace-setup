# ~/.bashrc — interactive shells. PATH is set in ~/.bash_profile.
# The bash twin of ~/.zshrc: same minimal setup, same prompt, same functions,
# NO command aliases. Byte-identical on every machine (Mac + Linux).

# Helper: source the first readable file from the list. Used for OS-aware
# sourcing (try Homebrew path first, fall back to Linux path).
_source_first() {
  local f
  for f in "$@"; do
    if [[ -r "$f" ]]; then
      . "$f"
      return 0
    fi
  done
  return 1
}

# PATH for every bash that reads this file — the twin of ~/.zshenv's job.
# Non-interactive `ssh host cmd` bypasses ~/.bash_profile but DOES read
# ~/.bashrc, so Homebrew and ~/.local/bin must be asserted before the
# interactivity gate below or remote commands get the bare sshd PATH.
# OS-aware: $BREW_PREFIX is exported by the provisioner (lib/os.sh). When
# absent (dotfiles used without the provisioner), fall back to `brew --prefix`
# so this works on macOS and Linuxbrew alike. On systems with no brew at all,
# the dir-test skips the prepend (no phantom PATH entries).
: "${BREW_PREFIX:=$(command -v brew >/dev/null 2>&1 && brew --prefix)}"
if [[ -n "$BREW_PREFIX" && -d "$BREW_PREFIX/bin" ]]; then
  case ":$PATH:" in *":$BREW_PREFIX/bin:"*) ;; *) PATH="$BREW_PREFIX/bin:$BREW_PREFIX/sbin:$PATH" ;; esac
fi
case ":$PATH:" in *":$HOME/.local/bin:"*)   ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac
export PATH BREW_PREFIX

# Locale safety net: ensure a UTF-8-capable LANG is set.
# macOS: region "en_AE" has no POSIX locale, so several contexts (Terminal.app,
#   ssh clients that don't send LANG, bare launchd) start bash with no usable
#   locale — brew bash 5.3 then prints "setlocale: … cannot change locale ()"
#   warnings the moment bash-completion (below) probes the locale.
# Linux: a fresh `sudo -i` shell, an SSH session with a stripped env, or a
#   minimal container can land with LANG=C / LANG=POSIX (ASCII-only — breaks
#   git, less, python, mosh-server refuses to start) or LANG= (empty).
# Default to en_US.UTF-8 (universally available, locale-neutral for CLI work)
# unless the current LANG is already UTF-8-capable. en_US.UTF-8 specifically
# (not C.UTF-8) because the `ds` mosh wrapper forces LC_ALL=en_US.UTF-8 and
# mosh-server exits 1 if that locale isn't generated.
case "${LANG:-}" in
  *.UTF-8|*.utf8) : ;;                                   # already UTF-8 → leave it
  *) export LANG=en_US.UTF-8 ;;                          # unset/empty/C/POSIX → upgrade
esac

# Non-interactive shells stop here (scp, `ssh host cmd`, scripts, …).
case $- in *i*) ;; *) return ;; esac

# SSH agent socket — on Linux the systemd user ssh-agent.socket exposes its
# socket at $XDG_RUNTIME_DIR/openssh_agent, but it's set in the systemd user
# manager environment, not automatically in every shell. Set it here if unset
# so the agent is actually used. Guarded on `[[ -z $SSH_AUTH_SOCK ]]` so that
# `ssh -A` agent forwarding into this host is NOT clobbered (the forwarded
# socket comes through sshd, which sets SSH_AUTH_SOCK itself). macOS doesn't
# need this — launchd sets SSH_AUTH_SOCK for every shell via the system agent.
if [[ -z "${SSH_AUTH_SOCK:-}" && -n "${XDG_RUNTIME_DIR:-}" ]] && [[ "$(uname -s)" != Darwin ]]; then
  if [[ -S "$XDG_RUNTIME_DIR/openssh_agent" ]]; then
    export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/openssh_agent"
  elif [[ -S "$XDG_RUNTIME_DIR/ssh-agent.socket" ]]; then
    # Arch / some other distros use this name
    export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
  fi
fi

# History — approximates zsh SHARE_HISTORY/IGNORE_ALL_DUPS: big, deduped,
# appended after every command instead of on shell exit.
HISTSIZE=100000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend
shopt -s checkwinsize

# Completion. Homebrew tools drop bash completions into
# $BREW_PREFIX/etc/bash_completion.d; bash-completion@2 lazy-loads them.
# On Linux, the path is /usr/share/bash-completion/bash_completion (apt's
# bash-completion package). Source whichever exists via _source_first.
if [[ -n "${BREW_PREFIX:-}" ]]; then
  _source_first "$BREW_PREFIX/etc/profile.d/bash_completion.sh" \
                /usr/share/bash-completion/bash_completion \
                /etc/bash_completion
else
  _source_first /usr/share/bash-completion/bash_completion /etc/bash_completion
fi

# ── Prompt & window title: WHICH MACHINE am I on? ───────────────────────────
# Same rule as ~/.zshrc: the #1 job of the prompt is making local-vs-remote
# unmistakable. Host badge + cwd + git branch; per-host accent colour.
case "$HOSTNAME" in
  *MacBook*|*macbook*)          _host_label='macbook'; _host_color=150 ;;  # green
  *Mac-mini*|*mac-mini*|*Mini*) _host_label='mini';    _host_color=215 ;;  # peach
  *)                            _host_label=${HOSTNAME%%.*}; _host_color=245 ;;  # other: grey + real name
esac

__prompt_git() {
  local b
  b=$(git symbolic-ref --short -q HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)
  [ -n "$b" ] && printf ' (%s)' "$b"
}
PS1="\[\e[1;38;5;${_host_color}m\]${_host_label}\[\e[0m\] \[\e[34m\]\w\[\e[0m\]\[\e[38;5;242m\]\$(__prompt_git)\[\e[0m\] \\$ "

# Terminal/tab title = "<machine>: <dir>" (kitty.conf uses `no-title` so the
# shell owns it). Also flush history after every command (see History above).
__set_term_title() { printf '\e]2;%s: %s\a' "$_host_label" "${PWD/#$HOME/\~}"; }
PROMPT_COMMAND='history -a; __set_term_title'

export EDITOR=nano

# yazi: `y` opens the file manager and cd's to the directory you quit in.
# Official wrapper: https://yazi-rs.github.io/docs/quick-start
# (mktemp: use $TMPDIR + XXXXXX template — portable across macOS and Linux.)
function y() {
	local tmp cwd
	tmp="$(mktemp "${TMPDIR:-/tmp}/yazi-cwd.XXXXXX")"
	command yazi "$@" --cwd-file="$tmp"
	cwd="$(command cat -- "$tmp" 2>/dev/null)"
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	command rm -f -- "$tmp"
}

# ds: durable remote session — mosh (survives wifi drop / network roam) + tmux
# on the remote (survives SSH disconnect; not remote reboot). Usage: ds mini | ds user@host
# LC_ALL forces a valid UTF-8 locale so mosh doesn't choke on macOS sending
# LC_CTYPE=UTF-8; the TERM downgrade matches ssh() so remote TUIs render on any host.
function ds() {
  local host="$1"
  if [ -z "$host" ]; then
    echo "usage: ds <host>" >&2
    return 2
  fi
  if ! command -v mosh >/dev/null 2>&1; then
    echo "ds: mosh is not installed locally" >&2
    return 127
  fi
  if ! command ssh -o BatchMode=yes -o ConnectTimeout=8 -o ConnectionAttempts=1 "$host" \
      'command -v mosh-server >/dev/null && command -v tmux >/dev/null' >/dev/null; then
    echo "ds: cannot reach $host over SSH, or remote is missing mosh-server/tmux" >&2
    echo "ds: check with: ssh -o ConnectTimeout=8 $host" >&2
    return 255
  fi
  LC_ALL=en_US.UTF-8 TERM=xterm-256color \
    mosh --ssh="ssh -o ConnectTimeout=8 -o ConnectionAttempts=1" "$host" -- tmux new -A -s main
}

# ssh: Kitty advertises TERM=xterm-kitty locally. OpenSSH sends that terminal
# type to remote PTYs, and many hosts do not have its terminfo installed. Keep
# the local Kitty TERM, but use xterm-256color for SSH by default.
function ssh() {
  local _ssh_term="${TERM:-xterm-256color}"
  case "$_ssh_term" in
    xterm-kitty|tmux-256color|screen-256color) _ssh_term=xterm-256color ;;
  esac
  TERM="$_ssh_term" command ssh "$@"
}

# s: short compatible SSH command. Usage: s mini | s user@host
function s() { ssh "$@"; }

# ks: opt in to Kitty's ssh kitten for hosts where you want Kitty integration.
function ks() { if command -v kitten >/dev/null 2>&1; then kitten ssh "$@"; else ssh "$@"; fi; }

# fzf: fuzzy finder. Ctrl-R fuzzy history · Ctrl-T insert file paths · Alt-C cd
# into a subdir · `**<Tab>` fuzzy completion. Official bash integration:
# https://github.com/junegunn/fzf
if command -v fzf >/dev/null 2>&1; then
  # Source `fd` (respects .gitignore, includes dotfiles, skips .git) for speed:
  command -v fd >/dev/null 2>&1 && {
    export FZF_DEFAULT_COMMAND='fd --hidden --strip-cwd-prefix --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type=d --hidden --strip-cwd-prefix --exclude .git'
  }
  # Layout + Catppuccin Mocha palette (https://github.com/catppuccin/fzf):
  export FZF_DEFAULT_OPTS="
    --height=60% --layout=reverse --border=rounded --info=inline
    --bind=ctrl-/:toggle-preview
    --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8
    --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc
    --color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8
    --color=selected-bg:#45475a,border:#585b70,label:#cdd6f4"
  # Previews: Ctrl-T shows files via bat / dirs via eza; Alt-C shows the tree;
  # Ctrl-R shows the full command (toggle with Ctrl-/).
  export FZF_CTRL_T_OPTS="--preview '(bat --color=always --style=numbers {} || eza --tree --color=always {}) 2>/dev/null | head -200'"
  export FZF_ALT_C_OPTS="--preview 'eza --tree --color=always {} 2>/dev/null | head -200'"
  export FZF_CTRL_R_OPTS="--preview 'echo {}' --preview-window=down:3:hidden:wrap --bind=ctrl-/:toggle-preview"
  # fzf's keybindings assume a real terminal; skip them in non-TTY shells
  # such as automated `bash -ic` SSH checks.
  if [ -t 0 ] && [ -t 1 ]; then
    eval "$(fzf --bash)"
    eval "$(zoxide init bash)"
  fi
fi

. "$HOME/.cargo/env"
