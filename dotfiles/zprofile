# macOS path_helper runs before this user login file and may put system paths
# back in front. Reassert the same deterministic order as ~/.zshenv.
typeset -U path PATH
path=(/usr/local/bin /usr/local/sbin $path)
if [[ -n "${BREW_PREFIX:-}" && -x "$BREW_PREFIX/bin/brew" ]]; then
  eval "$("$BREW_PREFIX/bin/brew" shellenv zsh)"
  path=("$BREW_PREFIX/bin" "$BREW_PREFIX/sbin" $path)
fi
path=("$HOME/.local/bin" $path)
export PATH BREW_PREFIX
