# shellcheck shell=sh
# ~/.profile — portable fallback for POSIX login shells.
if [ -f "$HOME/.cargo/env" ]; then
  . "$HOME/.cargo/env"
fi

_profile_prepend() {
  _profile_wanted=$1
  [ -d "$_profile_wanted" ] || return 0
  _profile_new=
  _profile_old_ifs=$IFS
  _profile_had_noglob=
  case $- in *f*) _profile_had_noglob=1 ;; *) set -f ;; esac
  IFS=:
  # shellcheck disable=SC2086 # colon-delimited iteration is intentional
  for _profile_entry in ${PATH:-}; do
    [ "$_profile_entry" = "$_profile_wanted" ] && continue
    _profile_new="${_profile_new}${_profile_new:+:}${_profile_entry}"
  done
  IFS=$_profile_old_ifs
  [ -n "$_profile_had_noglob" ] || set +f
  PATH="$_profile_wanted${_profile_new:+:$_profile_new}"
}

_profile_brew=
case "$(uname -s):$(uname -m)" in
  Darwin:arm64|Darwin:aarch64) _profile_candidates='/opt/homebrew/bin/brew /usr/local/bin/brew' ;;
  Darwin:*)                   _profile_candidates='/usr/local/bin/brew /opt/homebrew/bin/brew' ;;
  *)                          _profile_candidates='/home/linuxbrew/.linuxbrew/bin/brew /usr/local/bin/brew /opt/homebrew/bin/brew' ;;
esac
# shellcheck disable=SC2086 # fixed, space-delimited absolute path candidates
for _profile_candidate in $_profile_candidates; do
  if [ -x "$_profile_candidate" ]; then
    _profile_brew=$_profile_candidate
    break
  fi
done
_profile_prepend /usr/local/sbin
_profile_prepend /usr/local/bin
if [ -n "$_profile_brew" ]; then
  BREW_PREFIX=$("$_profile_brew" --prefix 2>/dev/null || true)
  if [ -n "$BREW_PREFIX" ]; then
    _profile_prepend "$BREW_PREFIX/sbin"
    _profile_prepend "$BREW_PREFIX/bin"
    export BREW_PREFIX
  fi
fi
_profile_prepend "$HOME/.local/bin"
export PATH
unset _profile_brew _profile_candidate _profile_candidates _profile_wanted _profile_new _profile_old_ifs _profile_had_noglob _profile_entry
unset -f _profile_prepend 2>/dev/null || true
